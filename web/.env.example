# Copy to web/.env.local and fill in. Never commit real keys.

# --- Meta Muse (AI host). Leave MUSE_API_KEY empty to run the deterministic MOCK host. ---
MUSE_API_KEY=
MUSE_API_BASE_URL=
MUSE_TEXT_MODEL=
MUSE_TRANSCRIBE_MODEL=
MUSE_IMAGE_MODEL=

# --- Apify (only needed to refresh the places cache: node scripts/fetch-places.ts) ---
APIFY_TOKEN=

# --- SpacetimeDB (browser-visible). Defaults: ws://<page host>:3000 and database "pitch-fight". ---
# For Maincloud: NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_HOST=
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=pitch-fight
