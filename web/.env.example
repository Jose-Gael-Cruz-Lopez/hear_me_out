# Copy to web/.env.local and fill in. Never commit real keys.

# --- Meta Muse (AI host). Leave MUSE_API_KEY empty to run the deterministic MOCK host. ---
MUSE_API_KEY=
MUSE_API_BASE_URL=
MUSE_TEXT_MODEL=
MUSE_TRANSCRIBE_MODEL=
MUSE_IMAGE_MODEL=

# --- Apify (only needed to refresh the cache: scripts/fetch-places.ts, then scripts/fetch-gems.ts) ---
APIFY_TOKEN=
# Optional actor overrides for the hidden-gems sources ("username~actor-name" from the Apify Store).
APIFY_REDDIT_ACTOR=
APIFY_INSTAGRAM_ACTOR=
APIFY_TIKTOK_ACTOR=
APIFY_SEARCH_ACTOR=
APIFY_CRAWLER_ACTOR=
# Optional: any event-listing actor, plus its input as JSON. Leave empty to skip events.
APIFY_EVENTS_ACTOR=
APIFY_EVENTS_INPUT=

# --- SpacetimeDB (browser-visible). Defaults: ws://<page host>:3000 and database "pitch-fight". ---
# For Maincloud: NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_HOST=
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=pitch-fight
